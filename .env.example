# Copy to .env and adjust. Every value has a default; invalid values fail at startup.
PORT=8000
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=3000
# mock (reads mockStatus from the inventory) | live (real HTTP GET per endpoint)
HEALTH_CHECKER=mock
HEALTH_CHECK_CHAOS=false
# LLM provider:
#   openai_compatible  any OpenAI-style /chat/completions API (OpenAI, Mistral, vLLM, ...); needs LLM_API_KEY
#   ollama             Ollama's native API, no key (local development only, not in docker compose)
#   none               rule-based analysis only, no model call
LLM_PROVIDER=openai_compatible
# API root including the version path. Examples:
#   Mistral  https://api.mistral.ai/v1   LLM_MODEL=mistral-small-latest | mistral-large-latest
#   OpenAI   https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#   Ollama   http://localhost:11434      LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
# Required for openai_compatible. Set the real key in your own .env only; never commit it.
LLM_API_KEY=
# json_schema (OpenAI, Mistral, vLLM) | json_object (for servers without JSON-schema output)
LLM_RESPONSE_FORMAT=json_schema
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=300
# REST API
API_HOST=127.0.0.1
# GET /api/v1/dr/analyze may only read files under this directory
API_ALLOWED_DIR=mock-data
API_MAX_UPLOAD_BYTES=1048576
API_WAIT_TIMEOUT_SECONDS=30
API_MAX_CONCURRENT_JOBS=1
API_MAX_STORED_JOBS=100
# comma-separated
CORS_ORIGINS=http://localhost:5173
# Runbook execution (Phase 9+, see docs/design/runbook-execution.md). Off by default.
EXECUTION_ENABLED=false
# Second opt-in: when false only dry runs can be created
EXECUTION_ALLOW_LIVE=false
MCP_SERVERS_FILE=mcp-servers.json
EXECUTION_POLICY_FILE=execution-policy.json
EXECUTION_APPROVAL_TIMEOUT_MINUTES=30
EXECUTION_TOOL_TIMEOUT_SECONDS=120
EXECUTION_MAX_TOOL_CALLS=50
EXECUTION_MAX_ACTIVE=3
# Ask the LLM for tool calls for steps without Tool: annotations (one model call per step)
EXECUTION_AI_PROPOSALS=true
# One SQLite file for analyses and executions (docs/design/analysis-history.md).
# EXECUTION_DB_PATH is the older name and is still read when DB_PATH is not set.
DB_PATH=dr-agent.db
# Analysis history: every finished analysis is stored with its runbook text (sensitive).
HISTORY_ENABLED=true
# Delete analyses without executions after this many days; 0 keeps them forever
HISTORY_RETENTION_DAYS=0
# Older analyses get a "health may have changed" warning before they are executed
HISTORY_STALE_AFTER_HOURS=24
# Knowledge base (docs/design/analysis-history.md section 9): use stored analyses and live runs
KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_RUNS=10
KNOWLEDGE_MAX_ANALYSES=20
# Send the allow-listed, code-measured history facts to the model (false: rules and report only)
KNOWLEDGE_IN_PROMPT=true
# Scheduled analysis (docs/design/scheduled-analysis.md). Off by default; needs HISTORY_ENABLED=true.
# The scheduler only analyzes and emails; executions are always started by a person.
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=30
SCHEDULER_MAX_SCHEDULES=50
# "Pause until" may be at most this many days ahead
SCHEDULER_MAX_PAUSE_DAYS=90
# IANA timezone for new schedules, e.g. Europe/Berlin
SCHEDULER_DEFAULT_TIMEZONE=UTC
# Email after each scheduled run: log (write a log line only) or smtp
NOTIFY_TRANSPORT=log
# Mailpit in Docker Compose listens on 1025; a real relay needs STARTTLS and a login
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
NOTIFY_FROM=dr-agent@example.com
# Used when the runbook owner is not in the contact directory (empty: no email then)
NOTIFY_DEFAULT_EMAIL=
# Comma-separated; every recipient must be in one of these domains
NOTIFY_ALLOWED_DOMAINS=example.com
# static = JSON file of name -> email (production: another directory implementation)
NOTIFY_DIRECTORY=static
NOTIFY_CONTACTS_FILE=mock-data/contacts.json
# Dashboard address for links in emails (empty: no link)
UI_BASE_URL=http://localhost:5173
# CLI only: show times in this IANA zone (empty: this machine's local time). The dashboard uses the
# browser's zone; everything is stored and exchanged in UTC.
DISPLAY_TIMEZONE=
# Saved runbook uploads: a folder inside API_ALLOWED_DIR, checked (must parse), never overwritten
RUNBOOK_UPLOADS_ENABLED=true
RUNBOOK_UPLOAD_DIR=uploads
RUNBOOK_UPLOAD_MAX_FILES=200
# Bundled mock MCP server only (python -m dr_agent.mock_mcp): scenario with start state and faults
# MOCK_MCP_SCENARIO=mock-data/scenarios/smoke-fails-once.json   (see mock-data/scenarios/)
